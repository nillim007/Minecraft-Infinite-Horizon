{
  "schema_version": 1,
  "entries": {
    "gravity": {
      "modifier_id": "infinite_horizon:planet_gravity",
      "update_interval_ticks": 10,
      "gravity_attribute": "minecraft:gravity",
      "gravity_per_g": 0.08,
      "fall_damage_multiplier": "g",
      "safe_fall_distance_numerator": 3,
      "safe_fall_distance_min_g": 0.05,
      "orbit_g": 0.005,
      "applies_to": [
        "players",
        "infinite_horizon:rover",
        "infinite_horizon:rocket"
      ],
      "projectiles_use_g": true,
      "explosion_vertical_knockback": "× 1/g bei g < 1",
      "modifier_operations": {
        "minecraft:gravity": "add_multiplied_total: g - 1",
        "minecraft:fall_damage_multiplier": "add_multiplied_total: g - 1",
        "minecraft:safe_fall_distance": "add_value: 3 / max(g, 0.05) - 3"
      },
      "apply_on": [
        "dimension_change",
        "respawn",
        "login",
        "interval"
      ],
      "jump_strength_unchanged": true,
      "mixins_from_milestone": 5,
      "spec_ref": "12.9, 3.7, 14.3",
      "notes": "gravity = 0,08 × g; safe_fall_distance = 3 / max(g, 0,05); fall_damage_multiplier = g. Monster und Items fallen mit Vanilla-Schwerkraft. Mond: Sprunghöhe rund 4,9 Blöcke (gewollt)."
    },
    "atmosphere_rules": {
      "block_tag": "infinite_horizon:needs_atmosphere",
      "tag_contents": [
        "#minecraft:candles",
        "minecraft:torch",
        "minecraft:wall_torch",
        "minecraft:soul_torch",
        "minecraft:soul_wall_torch",
        "minecraft:copper_torch",
        "minecraft:copper_wall_torch",
        "minecraft:fire",
        "minecraft:soul_fire",
        "minecraft:lantern",
        "minecraft:soul_lantern",
        "minecraft:campfire",
        "minecraft:soul_campfire"
      ],
      "placement": "denied",
      "denied_message": "message.infinite_horizon.no_atmosphere",
      "existing_torches": "random_tick_to_extinguished_torch",
      "existing_lit_blocks": "lit_false",
      "existing_other": "removed",
      "plant_tags": [
        "#minecraft:crops",
        "#minecraft:saplings"
      ],
      "plants_block_bonemeal": true,
      "ice_melts_in_freeze": false,
      "extinguished_torch_drops": "self",
      "applies": "Mod-Dimensionen außerhalb aktiver Kuppeln (failing zählt als aktiv)",
      "spec_ref": "8.5, 3.7",
      "notes": "Ä27. Redstone-Fackeln sind ausgenommen. IDs der Kupferfackel gegen 26.3 prüfen (3.1)."
    },
    "planet_mob_rules": {
      "weights": "wie Overworld",
      "rate_meaning": "Wahrscheinlichkeit, dass ein natürlicher Spawn bestehen bleibt",
      "light": "wie Overworld",
      "mask_render_layer": "Kopf; alle Dimensionen mit Planeten-Eintrag außer der Overworld",
      "burn_in_daylight": true,
      "spec_ref": "13.5"
    },
    "commands": {
      "goto": {
        "syntax": "/infinite_horizon goto <planet> [<x> <z>]",
        "permission_level": 2,
        "default_xz": [
          0,
          0
        ],
        "landing": "spaceflight.json landing_search",
        "overworld": "world_spawn"
      },
      "agency_info": {
        "syntax": "/infinite_horizon agency info [<spieler>]",
        "permission_level": 0
      },
      "agency_transfer": {
        "syntax": "/infinite_horizon agency transfer <von> <an>",
        "permission_level": 2
      },
      "spec_ref": "12.5, 23.1"
    },
    "agency_rules": {
      "roles": {
        "founder": "leader",
        "joined": "engineer"
      },
      "invite_by": "leader",
      "invite_targets": "online_players",
      "invite_storage": "AgencyData.invites",
      "invite_valid_until": "accepted_or_declined",
      "invite_notice": "chat",
      "accept_at": "any_research_terminal",
      "leave_creates_new_agency": true,
      "member_actions": [
        "OPEN",
        "USE_SLOTS",
        "CONFIGURE",
        "BUILD",
        "BREAK",
        "LAUNCH"
      ],
      "guest_actions": [
        "OPEN"
      ],
      "guest_slot_clicks": "discarded",
      "no_owner": "alle Aktionen erlaubt; wer das GUI zuerst öffnet, wird mit seiner Agentur Besitzer",
      "dome_protection": "Nicht-Mitglieder setzen und bauen in einer aktiven fremden Kuppel keinen Block ab",
      "operator_bypass_permission_level": 2,
      "research_unlock_min_role": "engineer",
      "spec_ref": "23.1, 23.2",
      "notes": "Ä28. Rollenwechsel, Umbenennen, Partner und Handel kommen mit M9."
    },
    "slow_fall": {
      "ticks": 400,
      "applies_to": [
        "orbit_fall_to_surface_planet",
        "asteroid_belt_fall_below_y0"
      ],
      "spec_ref": "14.3, 13.4"
    },
    "vacuum_sound": {
      "volume_multiplier": 0.15,
      "condition": "vacuum_without_dome",
      "exempt": [
        "suit_sounds",
        "warning_sounds"
      ],
      "spec_ref": "24.6, 3.7"
    },
    "multiblock_rules": {
      "structure_check_interval_ticks": 100,
      "structure_check_on": [
        "place",
        "neighbor_change",
        "interval"
      ],
      "ghost_projection_ticks": 200,
      "ghost_projection_trigger": "sneak_right_click_empty_hand",
      "spec_ref": "4.1, 4.3"
    },
    "titan_elytra": {
      "dimension": "infinite_horizon:titan",
      "glide_without_fireworks": true,
      "sink_rate_multiplier": 0.5,
      "spec_ref": "13.4"
    },
    "server_performance": {
      "landing_forceload_chunks": 1,
      "landing_forceload_ticks": 200,
      "spec_ref": "23.5"
    },
    "code_recipes": {
      "suit_module_install": {
        "machine": "infinite_horizon:assembly_table",
        "description_de": "Anzugteil + Modul im Montagetisch → Anzugteil mit eingebautem Modul (Data Component suit_modules, max. 2 Module je Teil). Gilt für alle Anzugteile und alle Module aus 9.2, das Modul muss zum Teil passen.",
        "ticks": null,
        "energy_per_tick": null,
        "match": "genau 1 Anzugteil + 1 passendes Modul; freier Modulslot; dieses Modul ist noch nicht eingebaut",
        "spec_ref": "9.2, 25.4"
      },
      "suit_module_remove": {
        "machine": "infinite_horizon:assembly_table",
        "description_de": "Anzugteil allein im Montagetisch → Anzugteil ohne Module als Hauptergebnis, die ausgebauten Module in die Nebenausgaben (3 Ausgabeslots).",
        "ticks": null,
        "energy_per_tick": null,
        "match": "genau 1 Anzugteil mit mindestens 1 Modul",
        "spec_ref": "9.2, 25.4"
      },
      "food_packing": {
        "machine": "infinite_horizon:food_packer",
        "description_de": "3 beliebige Nahrungsmittel → 1 space_ration; Nahrung und Sättigung = Summe der 3 Eingaben (max. 20), gespeichert in der Data Component nutrition.",
        "ticks": null,
        "energy_per_tick": null,
        "spec_ref": "6.1, 17"
      },
      "spec_ref": "25.4",
      "notes": "ticks/energy_per_tick null = Werte der Maschine aus balance/machines.json."
    },
    "advancements": {
      "tab": "infinite_horizon:root",
      "log_file": "logs/infinite_horizon-progress.log",
      "log_line": "ISO-8601-Zeit, Spielername, Erfolg-ID",
      "offline_storage": "AgencyData.pending_advancements",
      "by_id": {
        "infinite_horizon:root": {
          "parent": null,
          "icon": "infinite_horizon:engineers_handbook",
          "trigger": "minecraft:inventory_changed",
          "item": "infinite_horizon:engineers_handbook"
        },
        "infinite_horizon:ground_station": {
          "parent": "infinite_horizon:root",
          "icon": "infinite_horizon:research_terminal",
          "trigger": "minecraft:placed_block",
          "block": "infinite_horizon:research_terminal"
        },
        "infinite_horizon:first_signal": {
          "parent": "infinite_horizon:ground_station",
          "icon": "infinite_horizon:probe",
          "trigger": "minecraft:impossible",
          "granted_by": "code_all_members"
        },
        "infinite_horizon:small_step": {
          "parent": "infinite_horizon:first_signal",
          "icon": "infinite_horizon:moon_regolith",
          "trigger": "minecraft:changed_dimension",
          "to": "infinite_horizon:moon"
        },
        "infinite_horizon:own_air": {
          "parent": "infinite_horizon:small_step",
          "icon": "infinite_horizon:dome_generator_t1",
          "trigger": "minecraft:impossible",
          "granted_by": "code_all_members"
        }
      },
      "spec_ref": "24.3",
      "notes": "Ä28. Erzeugt werden nur Erfolge, deren Inhalte registriert sind (ab M4 diese 5); weitere kommen mit ihrem Meilenstein, der Feinschliff mit M9. Titel und Beschreibung DE/EN in lang_extra.json."
    },
    "config_defaults": {
      "file": "serverconfig/infinite_horizon.json",
      "recipe_amount_multiplier": {
        "default": 1.0,
        "min": 0.25,
        "max": 4.0
      },
      "oxygen_consumption": {
        "default": 1.0,
        "min": 0.5,
        "max": 2.0
      },
      "event_frequency": {
        "default": "normal",
        "values": [
          "off",
          "rare",
          "normal",
          "frequent"
        ]
      },
      "meteor_block_damage": {
        "default": true
      },
      "planet_mobs": {
        "default": true
      },
      "outposts_offline": {
        "default": true
      },
      "outpost_offline_factor": {
        "default": 0.5,
        "min": 0.0,
        "max": 1.0
      },
      "research_required": {
        "default": true
      },
      "spec_ref": "24.4, 3.5",
      "notes": "recipe_amount_multiplier gilt nur für stapelbare Item-Zutaten in Montagetisch-Rezepten (aufrunden, min. 1, max. 9 Slots)."
    }
  }
}
