{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/nillim007/Minecraft-Infinite-Horizon",
    "sources": "https://github.com/nillim007/Minecraft-Infinite-Horizon"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.infinitehorizon.InfiniteHorizonFabric"
    ],
    "client": [
      "de.infinitehorizon.InfiniteHorizonFabricClient"
    ],
    "fabric-gametest": [
      "de.infinitehorizon.gametest.IhFabricGameTests"
    ],
    "fabric-client-gametest": [
      "de.infinitehorizon.gametest.IhClientGameTests"
    ],
    "jei_mod_plugin": [
      "de.infinitehorizon.compat.jei.IhJeiPlugin"
    ],
    "rei_client": [
      "de.infinitehorizon.compat.rei.IhReiClientPlugin"
    ],
    "rei_common": [
      "de.infinitehorizon.compat.rei.IhReiCommonPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "team_reborn_energy": ">=5.0.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
