        "place",
        "neighbor_change",
        "interval"
      ],
      "ghost_projection_ticks": 200,
      "ghost_projection_trigger": "sneak_right_click_empty_hand",
      "spec_ref": "4.1, 4.3"
    },
    "titan_elytra": {
      "dimension": "sternenwerft:titan",
      "glide_without_fireworks": true,
      "sink_rate_multiplier": 0.5,
      "spec_ref": "13.4"
    },
    "server_performance": {
      "landing_forceload_chunks": 1,
      "landing_forceload_ticks": 200,
      "spec_ref": "23.5"
    },
    "code_recipes": {
      "suit_module_install": {
        "machine": "sternenwerft:assembly_table",
        "description_de": "Anzugteil + Modul im Montagetisch → Anzugteil mit eingebautem Modul (Data Component suit_modules, max. 2 Module je Teil). Gilt für alle Anzugteile und alle Module aus 9.2, das Modul muss zum Teil passen.",
        "ticks": null,
        "energy_per_tick": null,
        "spec_ref": "9.2, 25.4"
      },
      "suit_module_remove": {
        "machine": "sternenwerft:assembly_table",
        "description_de": "Anzugteil allein im Montagetisch → Anzugteil ohne Module als Hauptergebnis, die ausgebauten Module in die Nebenausgaben (3 Ausgabeslots).",
        "ticks": null,
        "energy_per_tick": null,
        "spec_ref": "9.2, 25.4"
      },
      "food_packing": {
        "machine": "sternenwerft:food_packer",
        "description_de": "3 beliebige Nahrungsmittel → 1 space_ration; Nahrung und Sättigung = Summe der 3 Eingaben (max. 20), gespeichert in der Data Component nutrition.",
        "ticks": null,
        "energy_per_tick": null,
        "spec_ref": "6.1, 17"
      },
      "spec_ref": "25.4",
      "notes": "ticks/energy_per_tick null = Werte der Maschine aus balance/machines.json."
    },
    "config_defaults": {
      "file": "serverconfig/sternenwerft.json",
      "recipe_amount_multiplier": {
        "default": 1.0,
        "min": 0.25,
        "max": 4.0
      },
      "oxygen_consumption": {
        "default": 1.0,
        "min": 0.5,
        "max": 2.0
      },
      "event_frequency": {
        "default": "normal",
